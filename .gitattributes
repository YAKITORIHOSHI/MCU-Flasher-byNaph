# Auto-detect text files and normalize line endings across all platforms
* text=auto eol=lf

# Source code and documentation
*.py text
*.json text
*.md text
*.txt text
*.html text
*.js text
*.css text
*.cpp text
*.cs text
*.h text
*.rc text
*.ini text
*.vbs text eol=crlf

# Known binary assets
*.ico binary
*.exe binary
*.dll binary
*.sys binary
*.cat binary
*.ttf binary

# Git LFS binary installers
installers/*.exe filter=lfs diff=lfs merge=lfs -text
installers/**/*.exe filter=lfs diff=lfs merge=lfs -text
installers/*.msi filter=lfs diff=lfs merge=lfs -text
installers/**/*.msi filter=lfs diff=lfs merge=lfs -text
