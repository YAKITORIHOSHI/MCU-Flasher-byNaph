# Auto-detect text files and normalize line endings across all platforms
* text=auto eol=lf

# Source code and documentation
*.py text
*.json text
*.md text
*.txt text
*.html text
*.js text
*.css text
*.cpp text
*.cs text
*.h text
*.rc text
*.ini text
*.vbs text eol=crlf

# Known binary assets
*.ico binary
*.exe binary
*.dll binary
*.sys binary
*.cat binary
*.ttf binary
# Native Ubuntu launchers must survive Windows checkouts byte-for-byte.
MCU_Flasher binary
MCU_Flasher-arm64 binary

# Public archives bundle the USB drivers and WebView2.
/installers/* export-ignore
/installers/CH34x -export-ignore
/installers/CP210x -export-ignore
/installers/MicrosoftEdgeWebview2Setup.exe -export-ignore

# Git LFS binary installers
installers/*.exe filter=lfs diff=lfs merge=lfs -text
installers/**/*.exe filter=lfs diff=lfs merge=lfs -text
installers/*.msi filter=lfs diff=lfs merge=lfs -text
installers/**/*.msi filter=lfs diff=lfs merge=lfs -text
