---
If:
  PathMatch: src/launcher\.cpp
CompileFlags:
  Add:
    [
      "-target",
      "x86_64-w64-mingw32",
      "-std=c++17",
      "-Illvm-mingw/include",
      "-Illvm-mingw/x86_64-w64-mingw32/include",
    ]
  Remove:
    - -fstrict-volatile-bitfields
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fno-tree-switch-conversion.*
    - .*tree-switch-conversion.*
    - -std=gnu99
    - -std=c99
    - -std=c11
    - -std=gnu11

---
If:
  PathMatch: llvm-mingw/.*
CompileFlags:
  Remove:
    - -fstrict-volatile-bitfields
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fno-tree-switch-conversion.*
    - .*tree-switch-conversion.*
    - -std=gnu99
    - -std=c99
    - -std=c11
    - -std=gnu11
Diagnostics:
  Suppress: "*"
