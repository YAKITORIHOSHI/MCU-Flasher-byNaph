# === PlatformIO / Arduino toolchain caches (these caused the "files too large" warning) ===
.pio/
.pioenvs/
.piolibdeps/
.platformio-mcu-gui/
src/libs/.platformio-mcu-gui/
env/*
!env/Scripts/
!env/Scripts/python.exe
env.platformio.cache/
**/.platformio/
**/platformio/cache/
**/platformio/downloads/
**/platformio/packages/

# Arduino CLI / IDE bootstrap artifacts
**/arduino-cli*
!installers/arduino-cli.msi
**/find_arduino_cli*
**/bootstrap_arduino_cli*

# NOTE: installers/*.exe and installers/*.msi are intentionally NOT
# ignored here — they're tracked via Git LFS (see .gitattributes).

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
*.spec
.venv/
venv/
env_gui/
_python/
src/_python/

# PyInstaller output (rebuildable, often large)
*.build/
*.dist/

# === Backups (you seem to keep manual backup folders — exclude unless intentional) ===
-backups*/
backups/
*backup*/

# === OS / Editor cruft ===
.DS_Store
Thumbs.db
desktop.ini
*.zip
.vscode/
.idea/
*.log
*.lock
$null


# === Project-specific caches ===
project.checksum
*.checksum
compile_cache/
*_syntax_errors.json
*_tab_order.json
*_gui_cache.json
src/gui_config.json
.mcu_gui_config.json

# === Compiled firmware / build artifacts (PlatformIO output) ===
*.o
*.d
*.bin
*.elf
*.map
*.a
*.dblite

.pio_cache/
soft_reset_project/boards/
soft_reset_project_uno/boards/
"index_json/library_index.json"

# === MCU Flasher dedicated internal app directories ===
MCU-FLASHER-SRC/
MCU_FLASHER_SRC/

# === Others ===
tests/flashertester
tests/env/
tests/index_json/
tests/logs/
tests/src/
.pio_bootstrap_first_use_*
cleaner
DANGER-ZONE