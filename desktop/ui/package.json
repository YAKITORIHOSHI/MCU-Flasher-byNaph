{
  "name": "mcu-flasher-transition-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets": "node ../scripts/stage-assets.mjs",
    "dev": "pnpm assets && vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/document-store.test.ts src/adapter.test.ts src/fixture-stream.test.ts",
    "build": "pnpm assets && pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort"
  },
  "dependencies": { "@tauri-apps/api": "2.12.4" },
  "devDependencies": { "typescript": "5.9.3", "vite": "8.3.4" }
}
